# Anthropic API key. Bring your own. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional: Figma MCP endpoint. Defaults to the official Figma Dev Mode MCP
# served by the Figma desktop app. Override if you run a different MCP server.
# FIGMA_MCP_URL=http://127.0.0.1:3845/sse

# Optional: model id. Defaults to claude-sonnet-4-6.
# Set to claude-opus-4-7 if pass-one decision quality needs the upgrade.
# COSIGN_MODEL=claude-sonnet-4-6
# COSIGN_MODEL_PASS_ONE=claude-sonnet-4-6
# COSIGN_MODEL_PASS_TWO=claude-sonnet-4-6

# Optional: sidecar port. UI is always on 5173 (Vite default).
# PORT=5174
